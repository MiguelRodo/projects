    {
      "id": "LT-C020",
      "contractRef": "dispatcher-mutable",
      "before": {"state": "unavailable"},
      "change": {"addRefs": [], "removeRefs": []},
      "expected": {"status": "failed", "diagnostic": "labels.before-state.unavailable"}
    },
    {
      "id": "LT-C021",
      "contractRef": "dispatcher-mutable",
