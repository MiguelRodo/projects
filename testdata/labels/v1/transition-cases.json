      "expected": {
        "status": "valid",
        "effectiveAddRefs": [],
        "effectiveRemoveRefs": ["blocked"],
        "afterNames": ["triage"],
        "targetRef": "primary",
        "subprojectRef": null,
        "generalLabelRefs": []
      }
    },
    {
      "id": "LT-C012",
      "contractRef": "dispatcher-mutable",
      "before": {"state": "unknown"},
      "change": {"addRefs": ["route-backend"], "removeRefs": []},
      "expected": {"status": "failed", "diagnostic": "labels.before-state.unknown"}
    },
    {
      "id": "LT-C013",
      "contractRef": "central-read-only",
      "before": {"state": "known", "values": ["project:alpha", "subproject:analysis"]},
      "change": {"addRefs": [], "removeRefs": ["subproject-analysis"]},
      "expected": {"status": "failed", "diagnostic": "labels.mutation.remove-forbidden"}
    },
    {
      "id": "LT-C014",
      "contractRef": "central-read-only",
      "before": {"state": "known", "values": ["project:alpha"]},
      "change": {"addRefs": ["subproject-analysis"], "removeRefs": []},
      "expected": {"status": "failed", "diagnostic": "labels.mutation.add-forbidden"}
    },
    {
      "id": "LT-C015",
      "contractRef": "dispatcher-mutable",
      "before": {"state": "known", "values": ["project:backend"]},
      "change": {"addRefs": ["missing-label"], "removeRefs": []},
      "expected": {
        "status": "failed",
        "diagnostic": "labels.change.unknown-ref",
        "labelRefs": ["missing-label"]
      }
    },
    {
      "id": "LT-C016",
      "contractRef": "dispatcher-mutable",
      "before": {"state": "known", "values": ["project:backend"]},
      "change": {"addRefs": ["blocked"], "removeRefs": ["blocked"]},
      "expected": {
        "status": "failed",
        "diagnostic": "labels.change.conflict",
        "labelRefs": ["blocked"]
      }
    },
    {
      "id": "LT-C017",
      "contractRef": "dispatcher-mutable",
      "before": {"state": "known", "values": ["project:backend"]},
      "change": {"addRefs": ["route-backend"], "removeRefs": ["blocked"]},
      "expected": {
        "status": "valid",
        "effectiveAddRefs": [],
        "effectiveRemoveRefs": [],
        "afterNames": ["project:backend"],
        "targetRef": "backend",
        "subprojectRef": null,
        "generalLabelRefs": []
      }
    },
    {
      "id": "LT-C018",
      "contractRef": "dispatcher-mutable",
      "before": {"state": "known", "values": ["project:backend", "subproject:api"]},
      "change": {
        "addRefs": ["route-frontend", "subproject-ui"],
        "removeRefs": ["route-backend", "subproject-api"]
      },
      "expected": {
        "status": "valid",
        "effectiveAddRefs": ["route-frontend", "subproject-ui"],
        "effectiveRemoveRefs": ["route-backend", "subproject-api"],
        "afterNames": ["project:frontend", "subproject:ui"],
        "targetRef": "frontend",
        "subprojectRef": "subproject-ui",
        "generalLabelRefs": []
      }
    },
    {
      "id": "LT-C019",
      "contractRef": "dispatcher-mutable",
      "before": {"state": "known", "values": ["project:backend", "subproject:api"]},
      "change": {"addRefs": ["route-frontend"], "removeRefs": ["route-backend"]},
      "expected": {
        "status": "failed",
        "diagnostic": "labels.subproject.target-mismatch",
        "subprojectRefs": ["subproject-api"]
