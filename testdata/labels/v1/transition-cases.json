      "change": {"addRefs": ["subproject-ui"], "removeRefs": []},
      "expected": {
        "status": "failed",
        "diagnostic": "labels.subproject.target-mismatch",
        "subprojectRefs": ["subproject-ui"]
      }
    },
    {
      "id": "LT-C010",
      "contractRef": "repository-scope-mutable",
      "before": {"state": "known", "values": ["triage"]},
      "change": {"addRefs": ["blocked", "subproject-api"], "removeRefs": []},
      "expected": {
        "status": "valid",
        "effectiveAddRefs": ["blocked", "subproject-api"],
        "effectiveRemoveRefs": [],
        "afterNames": ["blocked", "subproject:api", "triage"],
        "targetRef": "primary",
        "subprojectRef": "subproject-api",
        "generalLabelRefs": ["blocked"]
      }
    },
    {
