        "afterNames": ["project:backend", "subproject:database"],
        "targetRef": "backend",
        "subprojectRef": "subproject-database",
        "generalLabelRefs": []
      }
    },
    {
      "id": "LT-C009",
      "contractRef": "dispatcher-mutable",
