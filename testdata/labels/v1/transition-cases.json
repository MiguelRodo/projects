      "change": {"addRefs": [], "removeRefs": []},
      "expected": {"status": "failed", "diagnostic": "labels.before-state.forbidden"}
    },
    {
      "id": "LT-C022",
      "contractRef": "central-read-only",
      "before": {"state": "known", "values": ["project:alpha"]},
      "change": {"addRefs": ["route-alpha"], "removeRefs": ["subproject-analysis"]},
      "expected": {
        "status": "valid",
        "effectiveAddRefs": [],
        "effectiveRemoveRefs": [],
