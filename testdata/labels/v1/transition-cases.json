{
  "formatVersion": 1,
  "contracts": {
    "repository-scope-mutable": "testdata/contracts/v1/labels/valid/repository-scope-single.yaml",
    "central-read-only": "testdata/contracts/v1/labels/valid/central-single-required.yaml",
    "dispatcher-mutable": "testdata/contracts/v1/labels/valid/dispatcher-routes-subprojects.yaml"
  },
  "cases": [
    {
      "id": "LT-C001",
      "contractRef": "central-read-only",
      "before": {"state": "known", "values": ["project:alpha"]},
      "change": {"addRefs": [], "removeRefs": []},
      "expected": {
        "status": "valid",
        "effectiveAddRefs": [],
        "effectiveRemoveRefs": [],
        "afterNames": ["project:alpha"],
        "targetRef": "primary",
        "subprojectRef": null,
        "generalLabelRefs": []
      }
    },
    {
      "id": "LT-C002",
      "contractRef": "dispatcher-mutable",
      "before": {"state": "known", "values": []},
      "change": {"addRefs": ["route-backend"], "removeRefs": []},
      "expected": {
        "status": "valid",
        "effectiveAddRefs": ["route-backend"],
        "effectiveRemoveRefs": [],
        "afterNames": ["project:backend"],
        "targetRef": "backend",
        "subprojectRef": null,
        "generalLabelRefs": []
      }
    },
    {
      "id": "LT-C003",
      "contractRef": "dispatcher-mutable",
      "before": {"state": "known", "values": ["project:backend"]},
      "change": {"addRefs": ["route-frontend"], "removeRefs": []},
      "expected": {
        "status": "failed",
        "diagnostic": "routing.ambiguous",
        "routeLabelRefs": ["route-backend", "route-frontend"],
        "targetRefs": ["backend", "frontend"]
      }
    },
    {
      "id": "LT-C004",
      "contractRef": "dispatcher-mutable",
      "before": {"state": "known", "values": ["project:backend"]},
      "change": {"addRefs": [], "removeRefs": ["route-backend"]},
      "expected": {"status": "failed", "diagnostic": "routing.project-label.missing"}
    },
    {
      "id": "LT-C005",
      "contractRef": "dispatcher-mutable",
      "before": {"state": "known", "values": ["project:backend"]},
      "change": {"addRefs": ["route-frontend"], "removeRefs": ["route-backend"]},
      "expected": {
        "status": "valid",
        "effectiveAddRefs": ["route-frontend"],
        "effectiveRemoveRefs": ["route-backend"],
        "afterNames": ["project:frontend"],
        "targetRef": "frontend",
        "subprojectRef": null,
        "generalLabelRefs": []
      }
    },
    {
      "id": "LT-C006",
      "contractRef": "dispatcher-mutable",
