      "change": {"addRefs": ["subproject-database"], "removeRefs": []},
      "expected": {
        "status": "failed",
        "diagnostic": "labels.subproject.multiple",
        "subprojectRefs": ["subproject-api", "subproject-database"]
      }
    },
    {
      "id": "LT-C008",
      "contractRef": "dispatcher-mutable",
      "before": {"state": "known", "values": ["project:backend", "subproject:api"]},
      "change": {"addRefs": ["subproject-database"], "removeRefs": ["subproject-api"]},
      "expected": {
        "status": "valid",
