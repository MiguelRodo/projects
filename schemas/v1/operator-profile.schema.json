{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:projectctl:schema:operator-profile:v1",
  "title": "projectctl v1 private operator profile",
  "description": "A private, provider-neutral profile that binds one operator's choices and resources to explicitly selected shared repository contracts.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "projectctl/v1"
    },
    "kind": {
      "const": "OperatorProfile"
    },
    "spec": {
      "$ref": "#/$defs/profileSpec"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "contractRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "opaqueProviderRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?:\\S|\\S(?:[^\\r\\n]*\\S))$"
    },
    "privacyMode": {
      "enum": [
        "full_github_context",
        "shareable_by_default"
      ]
    },
    "owner": {
      "type": "object",
      "required": [
        "kind",
        "login"
      ],
      "properties": {
        "kind": {
          "enum": [
            "organization",
            "user"
          ]
        },
        "login": {
          "type": "string",
          "minLength": 1,
          "maxLength": 39,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
        }
      },
      "additionalProperties": false
    },
    "repositoryName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "contractSelector": {
      "type": "object",
      "required": [
        "authority",
        "owner",
        "repository",
        "ref"
      ],
      "properties": {
        "authority": {
          "const": "github.com"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "repository": {
          "$ref": "#/$defs/repositoryName"
        },
        "ref": {
          "$ref": "#/$defs/contractRef"
        }
      },
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "required": [
        "adapterRef"
      ],
      "properties": {
        "adapterRef": {
          "$ref": "#/$defs/contractRef"
        },
        "configurationRef": {
          "$ref": "#/$defs/contractRef"
        },
        "credentialRef": {
          "$ref": "#/$defs/contractRef"
        }
      },
      "additionalProperties": false
    },
    "companionDestination": {
      "type": "object",
      "required": [
        "providerRef",
        "resourceRef"
      ],
      "properties": {
        "providerRef": {
          "$ref": "#/$defs/contractRef"
        },
        "resourceRef": {
          "$ref": "#/$defs/opaqueProviderRef"
        }
      },
      "additionalProperties": false
    },
    "localPath": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "posix_absolute"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^/[^\\u0000\\r\\n]*$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "windows_drive_absolute"
            },
            "value": {
              "type": "string",
              "minLength": 3,
              "maxLength": 4096,
              "pattern": "^[A-Za-z]:[\\\\/][^\\u0000\\r\\n]*$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "windows_unc_absolute"
            },
            "value": {
              "type": "string",
              "minLength": 5,
              "maxLength": 4096,
              "pattern": "^\\\\\\\\[^\\u0000\\r\\n]+$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "workspace": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/localPath"
        }
      },
      "additionalProperties": false
    },
    "integration": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "providerRef",
            "resourceRef",
            "access"
          ],
          "properties": {
            "kind": {
              "enum": [
                "agenda",
                "registry",
                "source"
              ]
            },
            "providerRef": {
              "$ref": "#/$defs/contractRef"
            },
            "resourceRef": {
              "$ref": "#/$defs/opaqueProviderRef"
            },
            "access": {
              "const": "read_only"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "providerRef",
            "resourceRef",
            "access"
          ],
          "properties": {
            "kind": {
              "const": "cache"
            },
            "providerRef": {
              "$ref": "#/$defs/contractRef"
            },
            "resourceRef": {
              "$ref": "#/$defs/opaqueProviderRef"
            },
            "access": {
              "const": "pull_only"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "privacySelection": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/privacyMode"
        },
        "companionDestinationRef": {
          "$ref": "#/$defs/contractRef"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "full_github_context"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "not": {
              "required": [
                "companionDestinationRef"
              ]
            }
          }
        }
      ]
    },
    "sourceBindings": {
      "type": "object",
      "required": [
        "shared",
        "private"
      ],
      "properties": {
        "shared": {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": {
            "$ref": "#/$defs/contractRef"
          },
          "additionalProperties": {
            "$ref": "#/$defs/contractRef"
          }
        },
        "private": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contractRef"
          }
        }
      },
      "additionalProperties": false
    },
    "extensionBindings": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "agendaRef": {
          "$ref": "#/$defs/contractRef"
        },
        "registryRef": {
          "$ref": "#/$defs/contractRef"
        },
        "cacheRef": {
          "$ref": "#/$defs/contractRef"
        }
      },
      "additionalProperties": false
    },
    "contractBinding": {
      "type": "object",
      "required": [
        "contract",
        "sources"
      ],
      "properties": {
        "contract": {
          "$ref": "#/$defs/contractSelector"
        },
        "privacy": {
          "$ref": "#/$defs/privacySelection"
        },
        "workspaceRef": {
          "$ref": "#/$defs/contractRef"
        },
        "sources": {
          "$ref": "#/$defs/sourceBindings"
        },
        "extensions": {
          "$ref": "#/$defs/extensionBindings"
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "privacy"
          ]
        },
        {
          "required": [
            "workspaceRef"
          ]
        },
        {
          "properties": {
            "sources": {
              "properties": {
                "shared": {
                  "minProperties": 1
                }
              },
              "required": [
                "shared"
              ]
            }
          }
        },
        {
          "properties": {
            "sources": {
              "properties": {
                "private": {
                  "minItems": 1
                }
              },
              "required": [
                "private"
              ]
            }
          }
        },
        {
          "required": [
            "extensions"
          ]
        }
      ]
    },
    "providerMap": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "$ref": "#/$defs/contractRef"
      },
      "additionalProperties": {
        "$ref": "#/$defs/provider"
      }
    },
    "companionDestinationMap": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "$ref": "#/$defs/contractRef"
      },
      "additionalProperties": {
        "$ref": "#/$defs/companionDestination"
      }
    },
    "workspaceMap": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "$ref": "#/$defs/contractRef"
      },
      "additionalProperties": {
        "$ref": "#/$defs/workspace"
      }
    },
    "integrationMap": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "$ref": "#/$defs/contractRef"
      },
      "additionalProperties": {
        "$ref": "#/$defs/integration"
      }
    },
    "profileSpec": {
      "type": "object",
      "required": [
        "providers",
        "companionDestinations",
        "workspaces",
        "integrations",
        "contractBindings"
      ],
      "properties": {
        "providers": {
          "$ref": "#/$defs/providerMap"
        },
        "companionDestinations": {
          "$ref": "#/$defs/companionDestinationMap"
        },
        "workspaces": {
          "$ref": "#/$defs/workspaceMap"
        },
        "integrations": {
          "$ref": "#/$defs/integrationMap"
        },
        "contractBindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/contractBinding"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
