{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:projectctl:schema:repository-contract:v1",
  "title": "projectctl v1 repository contract",
  "description": "The collaborator-safe shared contract for one participating repository, one issue store and one or more GitHub Projects.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "projectctl/v1"
    },
    "kind": {
      "enum": [
        "DispatcherRepository",
        "SingleProjectRepository"
      ]
    },
    "spec": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "SingleProjectRepository"
        },
        "spec": {
          "$ref": "#/$defs/singleProjectSpec"
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "DispatcherRepository"
        },
        "spec": {
          "$ref": "#/$defs/dispatcherSpec"
        }
      }
    }
  ],
  "$defs": {
    "contractRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "privacyMode": {
      "enum": [
        "full_github_context",
        "shareable_by_default"
      ]
    },
    "companionAdvertisement": {
      "type": "object",
      "required": [
        "linkage"
      ],
      "properties": {
        "linkage": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "github_issue_node_id"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "privacyPolicy": {
      "type": "object",
      "required": [
        "supportedModes",
        "defaultMode"
      ],
      "properties": {
        "supportedModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/privacyMode"
          }
        },
        "defaultMode": {
          "$ref": "#/$defs/privacyMode"
        },
        "companion": {
          "$ref": "#/$defs/companionAdvertisement"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "defaultMode": {
                "const": "shareable_by_default"
              }
            },
            "required": [
              "defaultMode"
            ]
          },
          "then": {
            "properties": {
              "supportedModes": {
                "contains": {
                  "const": "shareable_by_default"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "defaultMode": {
                "const": "full_github_context"
              }
            },
            "required": [
              "defaultMode"
            ]
          },
          "then": {
            "properties": {
              "supportedModes": {
                "contains": {
                  "const": "full_github_context"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "companion"
            ]
          },
          "then": {
            "properties": {
              "supportedModes": {
                "contains": {
                  "const": "shareable_by_default"
                }
              }
            }
          }
        }
      ]
    },
    "owner": {
      "type": "object",
      "required": [
        "kind",
        "login"
      ],
      "properties": {
        "kind": {
          "enum": [
            "organization",
            "user"
          ]
        },
        "login": {
          "type": "string",
          "minLength": 1,
          "maxLength": 39,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
        }
      },
      "additionalProperties": false
    },
    "repositoryName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "issueStore": {
      "type": "object",
      "required": [
        "owner",
        "repository"
      ],
      "properties": {
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "repository": {
          "$ref": "#/$defs/repositoryName"
        }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": [
        "owner",
        "number"
      ],
      "properties": {
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "ref",
        "issueStore",
        "project"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/contractRef"
        },
        "issueStore": {
          "$ref": "#/$defs/issueStore"
        },
        "project": {
          "$ref": "#/$defs/project"
        }
      },
      "additionalProperties": false
    },
    "providerName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?:\\S|\\S(?:[^\\r\\n]*\\S))$"
    },
    "optionDescription": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^[^\\r\\n]*$"
    },
    "optionColor": {
      "enum": [
        "blue",
        "gray",
        "green",
        "orange",
        "pink",
        "purple",
        "red",
        "yellow"
      ]
    },
    "option": {
      "type": "object",
      "required": [
        "name",
        "color",
        "description"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/providerName"
        },
        "color": {
          "$ref": "#/$defs/optionColor"
        },
        "description": {
          "$ref": "#/$defs/optionDescription"
        }
      },
      "additionalProperties": false
    },
    "valueMap": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {
        "$ref": "#/$defs/contractRef"
      },
      "additionalProperties": {
        "$ref": "#/$defs/option"
      }
    },
    "scalarField": {
      "type": "object",
      "required": [
        "name",
        "dataType"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/providerName"
        },
        "dataType": {
          "enum": [
            "date",
            "number",
            "text"
          ]
        }
      },
      "additionalProperties": false
    },
    "singleSelectField": {
      "type": "object",
      "required": [
        "name",
        "dataType",
        "values"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/providerName"
        },
        "dataType": {
          "const": "singleSelect"
        },
        "values": {
          "$ref": "#/$defs/valueMap"
        }
      },
      "additionalProperties": false
    },
    "multiSelectField": {
      "type": "object",
      "required": [
        "name",
        "dataType",
        "values"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/providerName"
        },
        "dataType": {
          "const": "multiSelect"
        },
        "values": {
          "$ref": "#/$defs/valueMap"
        }
      },
      "additionalProperties": false
    },
    "field": {
      "oneOf": [
        {
          "$ref": "#/$defs/scalarField"
        },
        {
          "$ref": "#/$defs/singleSelectField"
        },
        {
          "$ref": "#/$defs/multiSelectField"
        }
      ]
    },
    "fieldMap": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "$ref": "#/$defs/contractRef"
      },
      "additionalProperties": {
        "$ref": "#/$defs/field"
      }
    },
    "labelName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "pattern": "^(?:\\S|\\S(?:[^\\r\\n]*\\S))$"
    },
    "labelColor": {
      "type": "string",
      "pattern": "^[0-9a-f]{6}$"
    },
    "labelDescription": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[^\\r\\n]*$"
    },
    "generalLabelRole": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "general"
        }
      },
      "additionalProperties": false
    },
    "targetLabelRole": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "targetRef"
          ],
          "properties": {
            "kind": {
              "const": "project_route"
            },
            "targetRef": {
              "$ref": "#/$defs/contractRef"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "targetRef"
          ],
          "properties": {
            "kind": {
              "const": "subproject"
            },
            "targetRef": {
              "$ref": "#/$defs/contractRef"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "label": {
      "type": "object",
      "required": [
        "name",
        "color",
        "description",
        "role"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/labelName"
        },
        "color": {
          "$ref": "#/$defs/labelColor"
        },
        "description": {
          "$ref": "#/$defs/labelDescription"
        },
        "role": {
          "oneOf": [
            {
              "$ref": "#/$defs/generalLabelRole"
            },
            {
              "$ref": "#/$defs/targetLabelRole"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "labelMap": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "$ref": "#/$defs/contractRef"
      },
      "additionalProperties": {
        "$ref": "#/$defs/label"
      }
    },
    "projectRouting": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "repository_scope"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "required_label"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "labels": {
      "type": "object",
      "required": [
        "declarations",
        "projectRouting"
      ],
      "properties": {
        "declarations": {
          "$ref": "#/$defs/labelMap"
        },
        "projectRouting": {
          "$ref": "#/$defs/projectRouting"
        }
      },
      "additionalProperties": false
    },
    "dispatcherLabels": {
      "allOf": [
        {
          "$ref": "#/$defs/labels"
        },
        {
          "properties": {
            "declarations": {
              "minProperties": 2
            },
            "projectRouting": {
              "properties": {
                "kind": {
                  "const": "required_label"
                }
              },
              "required": [
                "kind"
              ]
            }
          }
        }
      ]
    },
    "routeRule": {
      "type": "object",
      "required": [
        "ref",
        "labelRef",
        "targetRef"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/contractRef"
        },
        "labelRef": {
          "$ref": "#/$defs/contractRef"
        },
        "targetRef": {
          "$ref": "#/$defs/contractRef"
        }
      },
      "additionalProperties": false
    },
    "routeFallback": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "error"
        }
      },
      "additionalProperties": false
    },
    "routing": {
      "type": "object",
      "required": [
        "rules",
        "fallback"
      ],
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/routeRule"
          }
        },
        "fallback": {
          "$ref": "#/$defs/routeFallback"
        }
      },
      "additionalProperties": false
    },
    "dispatcherTarget": {
      "type": "object",
      "required": [
        "target",
        "fields"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/target"
        },
        "fields": {
          "$ref": "#/$defs/fieldMap"
        }
      },
      "additionalProperties": false
    },
    "hasDispatcherFields": {
      "type": "object",
      "required": [
        "targets"
      ],
      "properties": {
        "targets": {
          "contains": {
            "type": "object",
            "required": [
              "fields"
            ],
            "properties": {
              "fields": {
                "type": "object",
                "minProperties": 1
              }
            }
          }
        }
      }
    },
    "sourceRefs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/contractRef"
      }
    },
    "featureRequirements": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "issue-relationships",
          "issue-labels",
          "issues",
          "project-custom-fields",
          "project-item-membership",
          "projects-v2"
        ]
      },
      "allOf": [
        {
          "contains": {
            "const": "issues"
          }
        },
        {
          "contains": {
            "const": "projects-v2"
          }
        }
      ]
    },
    "mutationDeclarations": {
      "type": "array",
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "enum": [
          "issue.create",
          "issue.label.add",
          "issue.label.remove",
          "issue.relationship.create",
          "project.field.create",
          "project.field.option.create",
          "project.item.add",
          "project.item.field.write",
          "repository.label.create"
        ]
      }
    },
    "requirements": {
      "type": "object",
      "required": [
        "features",
        "mutations"
      ],
      "properties": {
        "features": {
          "$ref": "#/$defs/featureRequirements"
        },
        "mutations": {
          "$ref": "#/$defs/mutationDeclarations"
        }
      },
      "additionalProperties": false
    },
    "hasLabelDeclarations": {
      "type": "object",
      "required": [
        "labels"
      ],
      "properties": {
        "labels": {
          "type": "object",
          "required": [
            "declarations"
          ],
          "properties": {
            "declarations": {
              "type": "object",
              "minProperties": 1
            }
          }
        }
      }
    },
    "hasRequiredProjectRouting": {
      "type": "object",
      "required": [
        "labels"
      ],
      "properties": {
        "labels": {
          "type": "object",
          "required": [
            "projectRouting"
          ],
          "properties": {
            "projectRouting": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "required_label"
                }
              }
            }
          }
        }
      }
    },
    "labelPrerequisites": {
      "allOf": [
        {
          "if": {
            "$ref": "#/$defs/hasLabelDeclarations"
          },
          "then": {
            "properties": {
              "requirements": {
                "properties": {
                  "features": {
                    "contains": {
                      "const": "issue-labels"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "$ref": "#/$defs/hasRequiredProjectRouting"
          },
          "then": {
            "allOf": [
              {
                "$ref": "#/$defs/hasLabelDeclarations"
              },
              {
                "properties": {
                  "requirements": {
                    "properties": {
                      "features": {
                        "contains": {
                          "const": "issue-labels"
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "requirements": {
                "properties": {
                  "mutations": {
                    "contains": {
                      "enum": [
                        "issue.label.add",
                        "issue.label.remove",
                        "repository.label.create"
                      ]
                    }
                  }
                }
              }
            }
          },
          "then": {
            "allOf": [
              {
                "$ref": "#/$defs/hasLabelDeclarations"
              },
              {
                "properties": {
                  "requirements": {
                    "properties": {
                      "features": {
                        "contains": {
                          "const": "issue-labels"
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "singleProjectSpec": {
      "type": "object",
      "required": [
        "ref",
        "target",
        "fields",
        "labels",
        "sourceRefs",
        "requirements"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/contractRef"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "fields": {
          "$ref": "#/$defs/fieldMap"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "privacy": {
          "$ref": "#/$defs/privacyPolicy"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "requirements": {
          "$ref": "#/$defs/requirements"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/labelPrerequisites"
        },
        {
          "if": {
            "properties": {
              "fields": {
                "type": "object",
                "minProperties": 1
              }
            },
            "required": [
              "fields"
            ]
          },
          "then": {
            "properties": {
              "requirements": {
                "properties": {
                  "features": {
                    "contains": {
                      "const": "project-custom-fields"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "requirements": {
                "properties": {
                  "mutations": {
                    "contains": {
                      "const": "project.field.option.create"
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "minProperties": 1
              },
              "requirements": {
                "properties": {
                  "features": {
                    "contains": {
                      "const": "project-custom-fields"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "requirements": {
                "properties": {
                  "mutations": {
                    "contains": {
                      "const": "issue.relationship.create"
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "requirements": {
                "properties": {
                  "features": {
                    "contains": {
                      "const": "issue-relationships"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "requirements": {
                "properties": {
                  "mutations": {
                    "contains": {
                      "const": "project.field.create"
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "minProperties": 1
              },
              "requirements": {
                "properties": {
                  "features": {
                    "contains": {
                      "const": "project-custom-fields"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "requirements": {
                "properties": {
                  "mutations": {
                    "contains": {
                      "const": "project.item.add"
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "requirements": {
                "properties": {
                  "features": {
                    "contains": {
                      "const": "project-item-membership"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "requirements": {
                "properties": {
                  "mutations": {
                    "contains": {
                      "const": "project.item.field.write"
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "minProperties": 1
              },
              "requirements": {
                "properties": {
                  "features": {
                    "allOf": [
                      {
                        "contains": {
                          "const": "project-custom-fields"
                        }
                      },
                      {
                        "contains": {
                          "const": "project-item-membership"
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "dispatcherSpec": {
      "type": "object",
      "required": [
        "ref",
        "targets",
        "routing",
        "labels",
        "sourceRefs",
        "requirements"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/contractRef"
        },
        "targets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/dispatcherTarget"
          }
        },
        "routing": {
          "$ref": "#/$defs/routing"
        },
        "labels": {
          "$ref": "#/$defs/dispatcherLabels"
        },
        "privacy": {
          "$ref": "#/$defs/privacyPolicy"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "requirements": {
          "$ref": "#/$defs/requirements"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/labelPrerequisites"
        },
        {
          "if": {
            "$ref": "#/$defs/hasDispatcherFields"
          },
          "then": {
            "properties": {
              "requirements": {
                "properties": {
                  "features": {
                    "contains": {
                      "const": "project-custom-fields"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "requirements": {
                "properties": {
                  "mutations": {
                    "contains": {
                      "const": "project.field.option.create"
                    }
                  }
                }
              }
            }
          },
          "then": {
            "allOf": [
              {
                "$ref": "#/$defs/hasDispatcherFields"
              },
              {
                "properties": {
                  "requirements": {
                    "properties": {
                      "features": {
                        "contains": {
